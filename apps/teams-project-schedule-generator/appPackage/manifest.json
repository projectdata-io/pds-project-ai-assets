{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "2.1.23",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "WACG Inc.",
    "websiteUrl": "https://projectdata.io/",
    "privacyUrl": "https://projectdata.io/privacy-policy",
    "termsOfUseUrl": "https://projectdata.io/terms-conditions"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "PDS Schedule Generator ${{APP_NAME_SUFFIX}}",
    "full": "PDS Project AI: Project Schedule Generator"
  },
  "description": {
    "short": "Generate validated schedules informed by authorized M365 context.",
    "full": "Builds Microsoft Project schedules from user requirements and commits them to the requested destination. Connects to your existing PDS Project AI service. It applies requested plan changes and reports the committed result."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "project-schedule-generator",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
