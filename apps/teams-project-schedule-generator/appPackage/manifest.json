{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "2.3.17",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "WACG",
    "websiteUrl": "https://projectdata.io/",
    "privacyUrl": "https://projectdata.io/privacy-policy",
    "termsOfUseUrl": "https://projectdata.io/terms-conditions"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "PDS MPP Schedule Generator ${{APP_NAME_SUFFIX}}",
    "full": "PDS MPP: Project Schedule Generator"
  },
  "description": {
    "short": "Create, validate, and update Microsoft Project schedules from requirements.",
    "full": "Powered by PDS Project AI. Creates, validates, and updates Microsoft Project schedules from user requirements, then commits the completed plan to the requested destination."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "project-schedule-generator",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
