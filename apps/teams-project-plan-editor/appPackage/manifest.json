{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "2.3.13",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "WACG",
    "websiteUrl": "https://projectdata.io/",
    "privacyUrl": "https://projectdata.io/privacy-policy",
    "termsOfUseUrl": "https://projectdata.io/terms-conditions"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "PDS MPP Plan Editor ${{APP_NAME_SUFFIX}}",
    "full": "PDS MPP Plan Editor ${{APP_NAME_SUFFIX}}"
  },
  "description": {
    "short": "Stage requested plan edits informed by authorized M365 context.",
    "full": "Powered by PDS Project AI. Applies requested Microsoft Project edits and reports the committed result."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "project-plan-editor",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
