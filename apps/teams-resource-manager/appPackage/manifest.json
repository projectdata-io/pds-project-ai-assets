{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "2.1.23",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "WACG Inc.",
    "websiteUrl": "https://projectdata.io/",
    "privacyUrl": "https://projectdata.io/privacy-policy",
    "termsOfUseUrl": "https://projectdata.io/terms-conditions"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "PDS Resource Manager ${{APP_NAME_SUFFIX}}",
    "full": "PDS Project AI: Resource Manager"
  },
  "description": {
    "short": "Understand resource demand, capacity, and staffing pressure.",
    "full": "Helps you understand resource demand, overallocations, availability, costs, assignments, and near-term staffing pressure. Connects to your existing PDS Project AI service. It only reads project information and never changes your project files."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "resource-manager",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
