{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "PDS Project AI",
  "description_for_human": "Schedule Quality Analyst read-only MPP analysis.",
  "contact_email": "support@projectdata.io",
  "namespace": "pdsprojectaischedulequalityanalyst",
  "functions": [],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "spec": {
        "url": "https://mcp.projectdata.ai"
      },
      "run_for_functions": [
        "close_session",
        "create_session_from_onedrive",
        "create_session_from_reference",
        "get_entity_schema",
        "get_project",
        "list_assignments",
        "list_attributes",
        "list_calendars",
        "list_project_plan_picker_children",
        "list_project_plan_picker_containers",
        "list_resources",
        "list_tasks",
        "open_project_plan_picker",
        "select_project_plan_picker_file"
      ],
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "${{MCP_DA_AUTH_ID_SCHEDULE_QUALITY_ANALYST}}"
      }
    }
  ]
}
