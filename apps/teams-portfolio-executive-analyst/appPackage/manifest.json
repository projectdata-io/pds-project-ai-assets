{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "2.0.2",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "WACG Inc.",
    "websiteUrl": "https://projectdata.io/",
    "privacyUrl": "https://projectdata.io/privacy-policy",
    "termsOfUseUrl": "https://projectdata.io/terms-conditions"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "PDS Portfolio Analyst ${{APP_NAME_SUFFIX}}",
    "full": "ProjectData AI Essentials: Portfolio and Executive Analyst"
  },
  "description": {
    "short": "Read-only portfolio and executive project analysis.",
    "full": "Read-only leadership reporting agent for executive status, master-project rollups, milestones, cost, earned value, and plan comparison. Uses the existing PDS Project AI service and its metadata-only MPP picker."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "portfolio-executive-analyst",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
