{
  "name": "pds-project-ai-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Public agent assets for the PDS Project AI MCP server",
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile-copilot-studio.mjs",
    "compile:agent-flows": "node scripts/compile-agent-flow-templates.mjs",
    "deploy:agent-flows": "npm run compile:agent-flows && node scripts/deploy-agent-flows.mjs",
    "compile:solutions": "npm run compile && node scripts/compile-power-platform-solutions.mjs",
    "check:generated": "node scripts/compile-copilot-studio.mjs --check",
    "check:agent-flows": "node scripts/compile-agent-flow-templates.mjs --check",
    "verify:agent-flows": "node scripts/verify-agent-flow-templates.mjs",
    "test": "node scripts/validate-assets.mjs && npm run compile && npm run compile:agent-flows && npm run check:generated && npm run check:agent-flows && npm run verify:agent-flows"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}